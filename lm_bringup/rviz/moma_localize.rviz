Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
    - Class: rviz/PointCloud2
      Name: Prior map
      Enabled: true
      Topic: /map
      Queue Size: 1
      Size (m): 0.05
      Style: Points
      Color Transformer: FlatColor
      Color: 150; 150; 150
    - Class: rviz/PointCloud2
      Name: Registered scan
      Enabled: true
      Topic: /cur_scan_in_map
      Queue Size: 1
      Size (m): 0.08
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 255; 0
    - Class: rviz/PointCloud2
      Name: Matching submap
      Enabled: false
      Topic: /submap
      Size (m): 0.05
      Style: Points
      Color Transformer: FlatColor
      Color: 100; 100; 255
    - Class: rviz/Odometry
      Name: Global body pose
      Enabled: true
      Topic: /localization
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape: Arrow
    - Class: rviz/PoseWithCovariance
      Name: Initial pose used
      Enabled: false
      Topic: /initial_pose_used
    - Class: rviz/TF
      Name: TF
      Enabled: false
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
      Theta std deviation: 0.261799
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Pitch: 0.8
      Yaw: 0.8
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1200
  Height: 800
