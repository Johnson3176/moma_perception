<launch>

    <!-- 将已注册点云转换为 LaserScan，供下游使用 -->
    <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan">

        <!-- 输入话题 -->
        <remap from="cloud_in" to="/cloud_registered"/>

        <!-- 转换参数：距离和高度单位 m，时间单位 s，角度单位 rad -->
        <rosparam>
            # TF 等待容差与点云高度范围
            transform_tolerance: 0.01
            min_height: 0.0
            max_height: 1.0

            # 水平扫描角度与角度分辨率
            angle_min: -3.14159
            angle_max: 3.14159
            angle_increment: 0.0087 # M_PI/360.0
            # 扫描时间与有效距离范围
            scan_time: 10
            range_min: 0.05
            range_max: 30.0
            # 无回波表示与处理线程数
            use_inf: true
            inf_epsilon: 1.0

            concurrency_level: 1
        </rosparam>
    </node>
</launch>
